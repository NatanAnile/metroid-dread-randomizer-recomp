+/* MapProcessMemory / UnmapProcessMemory on the current process (exlaunch writes code through this alias). The guest has no real
+   alias, so the alias is a copy plus a snapshot of it: whenever any alias is unmapped, the words every active alias changed since
+   its last sync are written back to src (exlaunch keeps some aliases mapped for good, e.g. the trampoline pool and whole modules,
+   and unmaps the pages it patches right after filling it); src stays mapped and accessible */
+#define NPROC_ALIAS 16
+static struct { u64 dst, src, size; u8* snap; } g_palias[NPROC_ALIAS];
+
+static void proc_alias_sync(void){
+  for(int i=0;i<NPROC_ALIAS;i++) if(g_palias[i].size){
+    u8* a=GP(g_palias[i].dst); u8* o=g_palias[i].snap; u8* d=GP(g_palias[i].src); int n=0;
+    for(u64 b=0;b<g_palias[i].size;b+=0x1000){ if(!memcmp(a+b,o+b,0x1000)) continue;
+      for(u64 k=b;k<b+0x1000;k+=4) if(memcmp(a+k,o+k,4)){
+        if(g_verbose>=2 && n++<24) LOGV("procmem: %llx = %08x (was %08x)\n",(unsigned long long)(g_palias[i].src+k),*(u32*)(a+k),*(u32*)(d+k));
+        memcpy(d+k,a+k,4); memcpy(o+k,a+k,4); } } } }
+
+static u32 svc_map_proc_memory(u64 dst, u32 proc, u64 src, u64 size){
+  if(proc!=H_CUR_PROC) return R_BADHANDLE;
+  if((dst|src|size)&0xFFF || !size) return R_BADADDR;
+  if(dst<AS_BASE || dst+size>AS_SIZE) return R_BADREGION;   /* the ASLR region (GetInfo 12/13), where exlaunch picks a free spot */
+  int slot=0; while(slot<NPROC_ALIAS && g_palias[slot].size) slot++;
+  if(slot==NPROC_ALIAS) return R_OUTOFMEM;
+  u8* snap=malloc(size); if(!snap) return R_OUTOFMEM;
+  { int r=mem_map(dst,size,MS_ALIASCODEDATA,PERM_RW); if(r){ free(snap); return r==-1? R_BADMEMSTATE : R_OUTOFMEM; } }
+  memcpy(GP(dst),GP(src),size); memcpy(snap,GP(src),size);
+  g_palias[slot].dst=dst; g_palias[slot].src=src; g_palias[slot].size=size; g_palias[slot].snap=snap;
+  LOGV("procmem: map %llx <- %llx (%llx bytes)\n",(unsigned long long)dst,(unsigned long long)src,(unsigned long long)size);
+  return 0; }
+
+static u32 svc_unmap_proc_memory(u64 dst, u32 proc, u64 src, u64 size){
+  if(proc!=H_CUR_PROC) return R_BADHANDLE;
+  if((dst|src|size)&0xFFF || !size) return R_BADADDR;
+  LOGV("procmem: unmap %llx -> %llx (%llx bytes)\n",(unsigned long long)dst,(unsigned long long)src,(unsigned long long)size);
+  proc_alias_sync();
+  for(int i=0;i<NPROC_ALIAS;i++) if(g_palias[i].size && g_palias[i].dst==dst){ g_palias[i].size=0; free(g_palias[i].snap); g_palias[i].snap=NULL; }
+  mem_unmap(dst,size);
+  return 0; }
