+/* ExeFS patches from the mods: <data>/mods/<mod>/exefs/<BUILD ID>.ips (IPS32, offsets counted from the NSO header like
+   Atmosphere's), applied over the memory image of main, mods in load_order.txt order (else alphabetical). The randomizer
+   brings one: its HasRandomizerPatches sentinel plus a few code patches, which the generated code notices (HOOKED_INSNS) */
+static void ips_apply(const char* path, const SwrModInfo* mi){
+  u64 n; u8* f=read_all(path,&n); if(!f) return;
+  if(n<9 || memcmp(f,"IPS32",5)){ WARN("%s: not an IPS32 patch\n",path); free(f); return; }
+  u64 i=5; int recs=0;
+  while(i+4<=n && memcmp(f+i,"EEOF",4)){
+    if(i+6>n) break;
+    u64 off=((u64)f[i]<<24)|((u64)f[i+1]<<16)|((u64)f[i+2]<<8)|f[i+3]; u64 sz=((u64)f[i+4]<<8)|f[i+5]; i+=6;
+    u64 at= off>=0x100? off-0x100 : 0; u8 fill=0; const u8* src=NULL;
+    if(sz){ if(i+sz>n) break; src=f+i; i+=sz; }
+    else { if(i+3>n) break; sz=((u64)f[i]<<8)|f[i+1]; fill=f[i+2]; i+=3; }
+    if(off<0x100 || at+sz>mi->size){ WARN("%s: record at %llx outside the module\n",path,(unsigned long long)off); continue; }
+    if(src) memcpy(GP(mi->base+at),src,sz); else memset(GP(mi->base+at),fill,sz);
+    recs++; }
+  LOG("exefs patch %s: %d records\n",path,recs); free(f); }
+
+static int ips_cmp(const void* a, const void* b){ return strcmp(*(char* const*)a,*(char* const*)b); }
+
+static void ips_apply_mods(const SwrModInfo* mi){
+  char id[41]; for(int k=0;k<20;k++) snprintf(id+2*k,3,"%02X",mi->build_id[k]);
+  char root[1200]; snprintf(root,sizeof root,"%smods",g_datadir);
+  if(!plat_is_dir(root)) return;
+  char* names[256]; int nn=0; char lo[1300]; snprintf(lo,sizeof lo,"%s/load_order.txt",root);
+  FILE* lf=fopen(lo,"r");
+  if(lf){ char line[600];
+    while(fgets(line,sizeof line,lf) && nn<256){ char* s=line; while(*s==' '||*s=='\t') s++; size_t m=strlen(s); while(m && (s[m-1]=='\n'||s[m-1]=='\r'||s[m-1]==' ')) s[--m]=0;
+      if(*s && *s!='#' && *s!='-') names[nn++]=strdup(s); }
+    fclose(lf); }
+  else { PDir d; if(!plat_dir_open(&d,root)) { while(plat_dir_next(&d) && nn<256) if(d.is_dir && strcmp(d.name,".") && strcmp(d.name,"..")) names[nn++]=strdup(d.name); plat_dir_close(&d); }
+    qsort(names,nn,sizeof(char*),ips_cmp); }
+  for(int k=0;k<nn;k++){ char p[1500]; snprintf(p,sizeof p,"%s/%s/exefs/%s.ips",root,names[k],id);
+    FILE* t=fopen(p,"rb"); if(t){ fclose(t); ips_apply(p,mi); } free(names[k]); } }
